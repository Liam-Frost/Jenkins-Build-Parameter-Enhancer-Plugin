    "types": ["git"],
    "patterns": ["*_BRANCH", "BRANCH", "*_COMMIT", "*_COMMIT_HASH", "*_COMMIT_ID", "*_HASH", "*_SHA", "*_REVISION", "*_TAG", "*_REF", "GIT_*"]
