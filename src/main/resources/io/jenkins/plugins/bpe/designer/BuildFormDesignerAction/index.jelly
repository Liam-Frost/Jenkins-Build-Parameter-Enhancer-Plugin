<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="${%Design Build Form} - ${it.jobDisplayName}" type="one-column" permission="${it.job.CONFIGURE}">
    <l:main-panel>
      <link rel="stylesheet" type="text/css"
            href="${rootURL}/plugin/build-parameter-enhancer/generated/bpe-designer.css"/>
      <div id="bpe-designer"
           data-api="${rootURL}/${it.job.url}build-parameter-enhancer"
           data-build-url="${rootURL}/${it.job.url}build"
           data-job="${it.jobDisplayName}"
           data-i18n="${it.i18nJson}">
        <p class="jenkins-description">${%Loading the designer...}</p>
      </div>
      <script src="${rootURL}/plugin/build-parameter-enhancer/generated/bpe-designer.js" defer="true"><!-- --></script>
    </l:main-panel>
  </l:layout>
</j:jelly>
